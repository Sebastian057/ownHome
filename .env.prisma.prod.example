# Copy to `.env.prisma.prod`.
# Used only by guarded production Prisma scripts.
# Keep this file out of git and do not point it at any non-production environment.

DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Hard guard: the runner refuses to operate if hosts do not match.
EXPECTED_DATABASE_HOST=aws-0-eu-central-1.pooler.supabase.com
EXPECTED_DIRECT_HOST=aws-0-eu-central-1.pooler.supabase.com