# Copy to `.env.local` for application runtime during local development.
# Start the local stack first: `npm run db:local:start`
# Then inspect local service URLs and keys: `npm run db:local:status`

# Supabase local runtime
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=copy-from-npm-run-db-local-status
SUPABASE_SERVICE_ROLE_KEY=copy-from-npm-run-db-local-status

# Prisma local database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional local rate limiting - use your own dev Redis or leave blank if not testing those flows
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development