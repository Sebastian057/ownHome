# This file is now only a pointer.
# Use dedicated templates instead of mixing local runtime and production Prisma credentials.

# Local app runtime template:
#   .env.local.example -> .env.local

# Local Prisma template:
#   .env.prisma.local.example -> .env.prisma.local

# Production Prisma template:
#   .env.prisma.prod.example -> .env.prisma.prod

# Full workflow docs:
#   docs/local-dev-db.md
